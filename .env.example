# LuthCal environment — copy to .env.local and fill in. Never commit .env.local.

# --- Database (Neon Postgres via Vercel Marketplace) ---
DATABASE_URL=            # Neon pooled connection string

# --- AI (Claude via Vercel AI Gateway) ---
AI_GATEWAY_API_KEY=      # Vercel AI Gateway key; model string set in lib/agent

# --- Google Calendar (shared "Luthra Family" calendar is the source of truth) ---
GOOGLE_CLIENT_ID=        # OAuth 2.0 client ID
GOOGLE_CLIENT_SECRET=    # OAuth 2.0 client secret
GOOGLE_REFRESH_TOKEN=    # long-lived refresh token minted via scripts/google-auth.ts
FAMILY_CALENDAR_ID=      # calendar ID of the shared family calendar
APP_BASE_URL=            # public https URL of this deployment; used to register the Google
                         #   watch-channel webhook callback (lib/google/watch.ts). On Vercel
                         #   this can usually be left unset — VERCEL_URL is used as a fallback.

# --- BlueBubbles iMessage bridge (runs on the Mac) ---
BLUEBUBBLES_URL=         # public tunnel URL of the BlueBubbles server (Cloudflare Tunnel/ngrok);
                         #   falls back value if no bridge URL is stored in the `settings` table
                         #   yet (lib/bluebubbles.ts updates that row when the server reports its
                         #   URL changed)
BLUEBUBBLES_PASSWORD=    # BlueBubbles server password (API auth)
BLUEBUBBLES_WEBHOOK_SECRET=  # shared secret for the inbound webhook; BlueBubbles can't set custom
                         #   headers, so register the callback URL as
                         #   .../api/webhooks/bluebubbles?secret=<this value>
BLUEBUBBLES_SEND_METHOD=apple-script  # "apple-script" (default, works out of the box) or
                         #   "private-api" (needs SIP disabled on the Mac) — see
                         #   docs/bluebubbles-setup.md
FAMILY_CHAT_GUID=        # GUID of the family iMessage group chat
AGENT_IMESSAGE_HANDLE=   # the agent's own dedicated Apple ID (email/phone used to sign into
                         #   Messages.app on the bridge Mac, see docs/bluebubbles-setup.md §1).
                         #   Defense-in-depth loop guard: app/api/webhooks/bluebubbles drops any
                         #   inbound message whose sender handle matches this (case-insensitive),
                         #   as a second, independent check alongside BlueBubbles' own `isFromMe`
                         #   flag — belt-and-suspenders against the agent replying to itself.
                         #   Optional but recommended; the check is skipped if unset.

# --- App ---
CRON_SECRET=             # shared secret guarding /api/cron/* and webhook auth. On the Vercel
                         #   Hobby plan, sub-daily cron cadence (reminders/announce/outbound) is
                         #   delivered by the external GitHub Actions pinger instead of Vercel
                         #   Cron — that workflow needs this SAME value plus the deployment's
                         #   public URL set as GitHub repo secrets (`CRON_SECRET`, `APP_BASE_URL`),
                         #   not just here. See docs/cron-pinger.md.
FAMILY_PASSCODE=         # simple passcode gating the web dashboard
FAMILY_TZ=America/Chicago  # IANA timezone; ALL event/time math uses this, never server-local
