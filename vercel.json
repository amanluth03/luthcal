{
  "framework": "nextjs",
  "crons": [
    { "path": "/api/cron/digest?kind=daily", "schedule": "0 12 * * *" },
    { "path": "/api/cron/digest?kind=weekly", "schedule": "0 23 * * 0" },
    { "path": "/api/cron/reminders", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/announce", "schedule": "*/15 * * * *" },
    { "path": "/api/cron/outbound", "schedule": "*/5 * * * *" },
    { "path": "/api/cron/renew-watch", "schedule": "30 9 * * *" }
  ]
}
